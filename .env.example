# EduTrack - Academic Management System Environment Template
# Copy this file to .env and fill in your values

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection URI
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack

# Remote MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edutrack?retryWrites=true&w=majority

# Optional: Google Gemini API Key
# GEMINI_API_KEY=your_gemini_api_key_here
