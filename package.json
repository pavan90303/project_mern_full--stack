{
  "name": "edu-track-student-academic-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); if(fs.existsSync('frontend/dist')){fs.cpSync('frontend/dist','dist',{recursive:true});}\"",
    "build:frontend": "npm --prefix frontend run build",
    "start": "tsx backend/server.ts",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
